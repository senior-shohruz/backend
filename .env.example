# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/frontend_learning
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frontend_learning

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Frontend Learning Platform
DEBUG=True
API_V1_PREFIX=/api/v1

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Teacher (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# First admin user (created on startup if not exists)
FIRST_ADMIN_EMAIL=admin@platform.com
FIRST_ADMIN_PASSWORD=Admin123!
FIRST_ADMIN_USERNAME=admin
